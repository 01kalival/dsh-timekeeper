{
  "name": "dsh-timekeeper",
  "version": "0.3.0",
  "description": "Timekeeper for DeepSeek Harness — automatic usage tracking with insights, badges and shareable yearly reports. · 时间账本：自动统计你在 DeepSeek Harness 里的时间投入与习惯洞察：四维面板+环比、过去一年热力图、连续天数、时段洞察（24 小时/周内分布）、项目归属、每日目标、番茄钟、成就徽章、可分享年度总结卡片，以及数据导入导出。从进入 DSH 那一刻起自动计时，全部数据只存本机。",
  "icon": "assets/icon-256.png",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "timekeeper",
    "timer",
    "statistics",
    "heatmap",
    "streak",
    "achievements",
    "pomodoro",
    "insights",
    "projects"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets/logo.svg",
    "assets/icon-180.png",
    "assets/icon-256.png",
    "assets/icon-512.png",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-commands": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "author": "dsh-timekeeper contributors",
  "homepage": "https://github.com/OWNER/dsh-timekeeper#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/dsh-timekeeper.git"
  },
  "bugs": {
    "url": "https://github.com/OWNER/dsh-timekeeper/issues"
  }
}
